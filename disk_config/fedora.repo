# Used only by the throw-away ISO build image for installer depsolve.
# Keep in sync with the base image Fedora release.
[fedora]
name=Fedora $releasever
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&arch=$basearch
gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-$releasever-fedora
gpgcheck=1
enabled=1
priority=50
