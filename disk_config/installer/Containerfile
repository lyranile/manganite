# Installer environment image for Manganite (bootc + Anaconda Web UI), used to build a generic-iso.
# Produces an installer ISO (not a full desktop live session).
ARG INSTALLER_BASE=quay.io/fedora/fedora-bootc:45
FROM ${INSTALLER_BASE}

# Where the payload comes from during install (e.g. containers-storage:ghcr.io/lyra/lyra:latest
# for offline embedded payloads, or registry:ghcr.io/lyra/lyra:latest for network installs)
# and which ref the installed system should track for updates.
ARG PAYLOAD_SOURCE=registry:ghcr.io/lyranile/manganite:latest
ARG PAYLOAD_TARGET=ghcr.io/lyranile/manganite:latest

# Anaconda installer, modern Web UI frontend, and boot/ISO media dependencies.
RUN dnf5 install -qy \
      anaconda \
      anaconda-webui \
      firefox \
      anaconda-install-img-deps \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      net-tools \
      grub2-efi-x64-cdboot \
      plymouth \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      xorrisofs \
      squashfs-tools \
      jq \
    && dnf5 clean all

# EFI assets required on the ISO.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# ISO boot menu consumed by image-builder (generic-iso).
RUN mkdir -p /usr/lib/image-builder/bootc
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Optional Anaconda/Web UI profile overrides.
RUN mkdir -p /etc/anaconda/profile.d
COPY profile.d/ /etc/anaconda/profile.d/

# Tell Anaconda to install the bootc payload.
RUN cat > /usr/share/anaconda/interactive-defaults.ks <<EOF
bootc --source-imgref ${PAYLOAD_SOURCE} --target-imgref ${PAYLOAD_TARGET}
EOF

# Anaconda installer environment adjustments (per osbuild generic-iso guidance).
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    if [ -d /usr/share/dnf5/repos.d ]; then mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d; \
    elif [ -d /etc/yum.repos.d ]; then mv /etc/yum.repos.d /etc/anaconda.repos.d; fi && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d && \
    printf '[Login]\nReserveVT=2\n' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# Rebuild initramfs with Anaconda support for the installed kernel.
RUN mkdir -p "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version' | head -n1) && \
    test -n "${kernel}" && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
      --add "anaconda" \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Allow user-session services in installer environment where needed.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf
